# ── Interfejs TIKBENGOS ──────────────────────────────────────────
#
# Adres API. Ruch idzie przez proxy Next.js, żeby ciasteczko sesji zostało
# w tej samej domenie i nie trzeba było włączać CORS dla żadnego środowiska.
API_INTERNAL_URL=http://127.0.0.1:8000

# Adres kanału czasu rzeczywistego widziany z PRZEGLĄDARKI (nie z serwera).
# Bez tej zmiennej klient pokaże stan „nieskonfigurowany” zamiast zgadywać
# adres — patrz `apps/web/src/lib/realtime-client.ts`.
NEXT_PUBLIC_REALTIME_URL=ws://127.0.0.1:8001
