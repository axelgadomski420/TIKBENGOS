# Caddy — dwa przypadki: adres IP i nazwa domeny.
#
# Caddy wybrano nad nginxem z jednego powodu: sam zamawia i odnawia
# certyfikat Let's Encrypt. W nginxie to osobny proces (certbot) i własny
# harmonogram odnowienia — czyli jeszcze jedna rzecz, która potrafi przestać
# działać po cichu.
#
# DLACZEGO ADRES IP JEST OSOBNYM PRZYPADKIEM
# Caddy przyjmuje samą nazwę domeny (`example.com`) i wtedy SAM zamawia
# certyfikat przez ACME. Przy adresie IP nie ma czego zamawiać — Let's Encrypt
# NIE wydaje certyfikatów na adresy IP. Poprzednia wersja miała jedną regułę
# `{$DOMAIN}`, więc przy adresie Caddy próbował ACME, dostawał odmowę i kończył
# pracę z kodem 1. Kontener `proxy` wpadał w pętlę restartów, a strona nie
# odpowiadała — mimo że `web` i `api` działały poprawnie.
#
# NAPRAWIONY BŁĄD SKŁADNI — `header_upgrade` NIE ISTNIEJE
# Wcześniejsza wersja używała `header_upgrade Upgrade connection` i
# `header_upgrade Connection "Upgrade"`. Taka dyrektywa nie istnieje w Caddy;
# jest `header_up`. Caddy przerywał adaptację pliku komunikatem
#     unrecognized subdirective header_upgrade
# i kończył pracę PRZED wypisaniem czegokolwiek o błędzie — dlatego log
# kończył się na „using config from file” i wyglądało to na cichy restart.
# `validate --config` pokazało prawdziwy powód.
#
# Dla WebSocketów wystarcza samo `reverse_proxy` — Caddy sam rozpoznaje
# nagłówki `Upgrade` i `Connection` i przekazuje je dalej. Dopisywanie ich
# ręcznie jest zbędne, a zrobione błędnie psuje cały plik.

http://{$DOMAIN} {
	encode zstd gzip

	# ── Interfejs ────────────────────────────────────────────────
	# Ruch idzie tu domyślnie. Proxy w Next.js sam przekazuje dalej
	# wszystko, co zaczyna się od `/api/`.
	handle {
		reverse_proxy web:3000 {
			# Django porównuje `Host` z `ALLOWED_HOSTS`, a `web` widzi
			# adres usługi w sieci Dockera — bez tego nagłówka żądanie
			# dochodzi z hostem `web:3000` i dostaje 400.
			header_up Host {$DOMAIN}
		}
	}

	# ── Czas rzeczywisty ────────────────────────────────────────
	# Osobna ścieżka dla kanału WebSocket. Osobny blok, bo idzie do
	# innej usługi (port 8001), ale bez żadnych dodatkowych dyrektyw:
	# `reverse_proxy` obsługuje `Upgrade` sam.
	handle /ws/* {
		reverse_proxy realtime:8001 {
			header_up Host {$DOMAIN}
		}
	}

	# ── Nagłówki bezpieczeństwa ──────────────────────────────────
	# Bez `Strict-Transport-Security`: po HTTP ten nagłówek kazałby przeglądarce
	# wymuszać HTTPS, którego tu nie ma — i zablokowałby dostęp do aplikacji.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	log {
		output stdout
		format console
	}
}

# ── GDY BĘDZIE DOMENA ───────────────────────────────────────────
# Zmień `DOMAIN` w `.env` na nazwę domeny i odkomentuj tę regułę, usuwając
# poprzednią. Caddy zamówi certyfikat sam, a HSTS wróci.
#
# {$DOMAIN} {
# 	encode zstd gzip
# 	handle {
# 		reverse_proxy web:3000
# 	}
# 	handle /ws/* {
# 		reverse_proxy realtime:8001
# 	}
# 	header {
# 		Strict-Transport-Security "max-age=31536000; includeSubDomains"
# 		X-Content-Type-Options "nosniff"
# 		Referrer-Policy "strict-origin-when-cross-origin"
# 		Content-Security-Policy "frame-ancestors 'none'"
# 	}
# 	log {
# 		output stdout
# 		format console
# 	}
# }
