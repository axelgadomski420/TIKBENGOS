# ── Infrastruktura ───────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=                     # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Baza danych (PostgreSQL) ─────────────────────────────────────
POSTGRES_DB=tikbengos
POSTGRES_USER=tikbengos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── Redis — kolejka i warstwa WebSocket ──────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Szyfrowanie kluczy API użytkowników ─────────────────────────
# Klucze wpisywane w ustawieniach aplikacji są szyfrowane tym kluczem.
# Wygeneruj raz i nigdy nie zmieniaj bez ponownego zaszyfrowania danych:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Powiadomienia push (PWA) ────────────────────────────────────
# Nie zdecydowane: usługa zewnętrzna czy własna implementacja VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Logowanie przez dostawcę zewnętrznego ───────────────────────
# Opcjonalne. Bez tych wartości endpointy logowania przez dostawcę zwracają
# 503 z wyjaśnieniem, a ekran logowania pokazuje przycisk nieaktywny —
# nie ma tu żadnej wartości wpisanej na sztywno ani udawanej.
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
#   OAuth client ID → Web application. Jako "Authorized redirect URI"
#   wpisz DOKŁADNIE ten adres (dla Google litera w literę):
#       {adres aplikacji}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers → OAuth Apps → New OAuth App.
#   "Authorization callback URL" to ten sam wzór:
#       {adres aplikacji}/api/auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Baza adresu zwrotnego. Z niej powstają oba adresy callbacku powyżej.
# Jeśli puste, bierzemy pierwszy wpis z CSRF_TRUSTED_ORIGINS.
# Adres musi być identyczny z tym w panelu dostawcy — rozjazd daje
# `redirect_uri_mismatch`, najczęstszy błąd przy pierwszym podłączeniu.
OAUTH_REDIRECT_BASE=

# ── GitHub App (BENGOS Dev) ─────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# ── Workery AI ──────────────────────────────────────────────────
# Muzyka: MusicGen potrzebuje GPU z 16 GB pamięci. Nie uruchamiaj na Oracle.
MUSIC_WORKER_URL=
SIGN_WORKER_URL=
CODE_WORKER_URL=
