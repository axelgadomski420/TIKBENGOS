# ── Infrastruktura ───────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=                     # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Baza danych (PostgreSQL) ─────────────────────────────────────
POSTGRES_DB=tikbengos
POSTGRES_USER=tikbengos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Szyfrowanie kluczy API ───────────────────────────────────────
FIELD_ENCRYPTION_KEY=

# ── Powiadomienia push ───────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Logowanie zewnętrzne ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=

# ── GitHub App ───────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# ── Pluter AI; worker używa tych samych wartości w Compose ────────
# Wygeneruj unikalny sekret, np. python -c "import secrets; print(secrets.token_urlsafe(48))"
BENGOS_WORKER_TOKEN=
PLUTER_API_BASE_URL=https://api.openai.com/v1
PLUTER_API_KEY=
PLUTER_MODEL=
TAVILY_API_KEY=
ASSISTANT_LLM_ENDPOINT=http://ai-worker:8092/jobs
ASSISTANT_MODEL=

# ── Opcjonalne moduły ────────────────────────────────────────────
MUSICGEN_ENDPOINT=
MUSIC_DAILY_LIMIT=10
GITHUB_TOKEN=
BENGOS_CODE_EXECUTOR_URL=
MUSIC_WORKER_URL=
SIGN_WORKER_URL=
CODE_WORKER_URL=
