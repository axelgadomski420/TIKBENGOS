successfully downloaded text file (SHA: 6b10d5014fd2232d640f7f331ed86464caf73405)# ── Wdrożenie produkcyjne ──────────────────────────────────────────
#
# Ten plik jest źródłem zmiennych dla `infra/docker-compose.prod.yml`.
# Skopiuj do `.env` w korzeniu repozytorium i wypełnij — `compose` przerywa
# start, gdy którejś brakuje, więc puste pole zatrzyma Cię od razu, a nie
# po uruchomieniu.
#
# Pliku `.env` NIE dodawaj do repozytorium. Klucze tu wpisane są sekretami.
# `scripts/deploy.sh` generuje ten plik sam — nie musisz go wypełniać
# ręcznie, jeśli używasz skryptu. Ten wzór jest dla wdrożenia ręcznego.

# ── Domena i certyfikat ──────────────────────────────────────────
# Nazwa, pod którą aplikacja odpowiada. Caddy sam zamówi dla niej certyfikat,
# a to wymaga, żeby domena faktycznie wskazywała na tę maszynę (rekord A).
# Przy samym adresie IP certyfikatu nie będzie — patrz docs/deploy-oracle.md.
DOMAIN=tikbengos.example.com
# Adres, na który Let's Encrypt wyśle ostrzeżenie o wygasającym certyfikacie.
ACME_EMAIL=ty@example.com

# ── Django ──────────────────────────────────────────────────────
# Wygeneruj raz: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Wygeneruj RAZ i nigdy nie zmieniaj — zmiana uniemożliwia odszyfrowanie
# wszystkich zapisanych kluczy dostawców:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Poprawność tego klucza sprawdza: docker compose exec api python manage.py sprawdz
FIELD_ENCRYPTION_KEY=
ALLOWED_HOSTS=tikbengos.example.com
CSRF_TRUSTED_ORIGINS=https://tikbengos.example.com

# ── Baza danych ────────────────────────────────────────────────
POSTGRES_DB=tikbengos
POSTGRES_USER=tikbengos
# Bez domyślki. Wymyśl długie hasło — ten serwer stoi na publicznym adresie.
POSTGRES_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────
# Ma własne hasło, bo choć nie jest wystawiony na świat, siedzi w tej samej
# sieci Dockera co reszta usług — a ta sieć jest wspólna dla kontenerów.
REDIS_PASSWORD=

# ── Czas rzeczywisty ────────────────────────────────────────────
# Adres kanału WebSocket widziany z PRZEGLĄDARKI (nie z serwera).
# `wss` przy HTTPS, `ws` przy samym IP. Klient dokleja do tej wartości
# nazwę kanału (`/chat/`), a serwer ma trasy pod `ws/chat/` i `ws/presence/`
# — patrz `services/api/accounts/routing.py`.
# Bez tej zmiennej klient pokaże stan „nieskonfigurowany”, a kontener
# `realtime` będzie działał, choć nic się z nim nie połączy.
NEXT_PUBLIC_REALTIME_URL=wss://tikbengos.example.com/ws

# ── Moduły opcjonalne ──────────────────────────────────────────
# Wszystkie poniższe są opcjonalne: puste pole = moduł odpowiada
# "nie skonfigurowano" (503), zamiast udawać działanie. Compose
# przekaże je do kontenera API tylko dlatego, że są w prod compose.

# Logowanie przez dostawcę. Gdy je ustawisz, baza adresu zwrotnego
# bierze się z CSRF_TRUSTED_ORIGINS (pierwsza pozycja).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# BENGOS Dev: token GitHuba (plany + pull requesty) i adres executora
# zmian kodu (Aider z TIKGIT).
GITHUB_TOKEN=
BENGOS_CODE_EXECUTOR_URL=

# BENGOS Music: maszyna z GPU i limit generacji dziennie na użytkownika
# (musi być liczbą — pusty ciąg zatrzyma start API).
MUSICGEN_ENDPOINT=
MUSIC_DAILY_LIMIT=10

# Sekret wspólny dla endpointów zwrotnych /jobs/{id}/complete — musi być
# TEN SAM po stronie API i każdego workera (GPU, executor, asystent).
# Puste = endpointy zwrotne zwracają 403 dla każdego żądania.
BENGOS_WORKER_TOKEN=

# BENGOS Asystent: adres usługi z modelem (np. Ollama) i nazwa modelu.
ASSISTANT_LLM_ENDPOINT=
ASSISTANT_MODEL=
