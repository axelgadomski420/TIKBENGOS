# ── Czas rzeczywisty ────────────────────────────────────────────
#
# Adres kanału WebSocket. Wartość z `scripts/deploy.sh` to
# `wss://$DOMAIN/ws` przy HTTPS albo `ws://$DOMAIN/ws` przy samym IP.
#
# Uwaga na kształt: klient dokleja nazwę kanału (`/chat/`) do tej wartości,
# a serwer ma trasy pod `ws/chat/` i `ws/presence/` — patrz
# `services/api/accounts/routing.py`. Zmiana tu bez zmiany tam zostawia
# klienta celującego w adres, którego serwer nie zna.
NEXT_PUBLIC_REALTIME_URL=wss://tikbengos.example.com/ws
