# Skopiuj do .env na maszynie Oracle. Nie commituj .env.
MYSQL_ROOT_PASSWORD=change-me-purre-pets
HTTP_PORT=80

# Publiczny adres, pod którym stoi nginx (bez końcowego slasha).
APP_FRONTEND_BASE_URL=http://localhost
APP_BACKEND_BASE_URL=http://localhost/elif

# WebSocket. * działa za reverse proxy na tej samej domenie.
APP_WS_ALLOWED_ORIGIN_PATTERNS=*

# Opcjonalne integracje. Puste = funkcja wyłączona, aplikacja wstaje.
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GIPHY_API_KEY=
GOOGLE_CLIENT_ID=
WEATHER_API_KEY=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
