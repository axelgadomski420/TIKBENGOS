# ── Sekrety i pliki lokalne — nigdy do repozytorium ────────────────
#
# Ten plik uzupełnia to, co poniżej. Sekcje poniżej są nietknięte celowo.

# Klucze prywatne SSH (Oracle daje plik `.key` do pobrania) i certyfikaty.
*.key
*.pem
*.crt

# Zrzuty bazy i wolumeny lokalne. `kopia-*.sql` to nazwa, której używa
# `scripts/napraw.sh kopia` — bez tego wpisu zrzut bazy trafiłby do repo.
kopia-*.sql
backup*.sql.gz
data/
*.dump
*.sql

# Kopie wzorców z wypełnionymi sekretami. Wzorce zostają w repozytorium
# (`!.env.example` niżej), wypełnione kopie już nie.
infra/.env

# Katalog tymczasowy `dev.sh` i `generate-icons.py`. `scratch/` jest
# ignorowany w całości — trzymamy tam klucze deweloperskie i bazę SQLite.
scratch/

# Pokrycie testów.
coverage/
.nyc_output/

# Wynik generatora ikon trafia do repozytorium (PWA potrzebuje plików),
# więc nie jest ignorowany. Skrypt, który go tworzy, leży w `scripts/`.

# ── Zależności ────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# Buildy
.next/
out/
dist/
build/
turbo/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
site-packages/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Sekrety — nigdy w repozytorium
.env
.env.*
!.env.example
!.env.prod.example
!.env.local.example

# Bazy danych lokalne
*.sqlite3
db.sqlite3

# Media wygenerowane lokalnie
media/
staticfiles/

# Edytory i system
.vscode/
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Logi
*.log
logs/
